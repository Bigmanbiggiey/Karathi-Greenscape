# Copy this file to `.env` on the server (same directory as docker-compose.prod.yml).
# Never commit the real .env — it holds production secrets.

# Django
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=karathi-demo.techbiggiey.org
# Scheme + host, comma-separated. Required for the Django admin behind the proxy.
CSRF_TRUSTED_ORIGINS=https://karathi-demo.techbiggiey.org
# Mark session/CSRF cookies Secure (production is served over HTTPS at the edge).
DJANGO_SECURE_COOKIES=True

# Database (used by both the postgres container and Django's DATABASE_URL)
POSTGRES_DB=karathi_greenscape
POSTGRES_USER=karathi
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://karathi:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/karathi_greenscape

# Frontend build-time API origin (same origin as the deployed site — nginx proxies /api to backend)
VITE_API_URL=https://karathi-demo.techbiggiey.org

# Public base URL of the SPA — used to build password-reset links in emails (no trailing slash)
FRONTEND_URL=https://karathi-demo.techbiggiey.org

# Email / SMTP — REQUIRED in production (transactional mail: password resets).
# Django refuses to start with DEBUG=False unless EMAIL_HOST, EMAIL_HOST_USER and
# EMAIL_HOST_PASSWORD are all set. Values below are for a typical Gmail/Workspace
# SMTP relay; adjust host/port for your provider.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# From address on outgoing mail (defaults to EMAIL_HOST_USER if omitted)
DEFAULT_FROM_EMAIL=Karathi Greenscape <no-reply@karathi-demo.techbiggiey.org>

# M-Pesa (sandbox for now)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://karathi-demo.techbiggiey.org/api/payment/mpesa/callback/
MPESA_ENVIRONMENT=sandbox

# Airtel Money (staging for now)
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_API_KEY=
AIRTEL_ENV=staging
